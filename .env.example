# Settings for the plain HTTP stack (docker-compose.yml).
# Copy to .env and adjust; docker compose reads it automatically. For HTTPS, start from
# .env.https.example instead.

# Host port the app is published on. The UI lives at http://<host>:<PORT>/
PORT=7860

# Host folder with your LoRAs (.safetensors / .pt), mounted at /data/loras. Create it before the
# first start so it is owned by you rather than root.
LORAS_DIR=./loras

# Extra studio.py flags.
FRAMEPACK_SERVE_ARGS=
# e.g. FRAMEPACK_SERVE_ARGS=--offline    (once the weights are downloaded)

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=

# GPU architectures SageAttention is compiled for when the image is built. The default covers
# Ampere, Ada, Hopper and Blackwell; listing only your own GPU builds much faster, e.g. 8.9 for
# an RTX 40-series card (nvidia-smi --query-gpu=compute_cap --format=csv shows yours).
TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0;12.0
