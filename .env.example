# Settings for the plain HTTP stack (docker-compose.yml).
# Copy to .env and adjust; docker compose reads it automatically. For HTTPS, start from
# .env.https.example instead.

# Host port the app is published on. The UI lives at http://<host>:<PORT>/
PORT=7860

# Host folder with your LoRAs (.safetensors / .pt), mounted at /data/loras. Create it before the
# first start so it is owned by you rather than root.
LORAS_DIR=./loras

# Extra studio.py flags.
FRAMEPACK_SERVE_ARGS=
# e.g. FRAMEPACK_SERVE_ARGS=--offline    (once the weights are downloaded)

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=

# Attention backend compiled into the image: sage (fastest, but compiled from source, which takes a
# while), flash (a prebuilt flash-attn wheel, no compiling) or none (PyTorch's own attention). Both
# sage and flash need an RTX 30-series or newer GPU; older GPUs fall back to PyTorch's attention.
ATTENTION=flash

# GPU architectures SageAttention is compiled for. The default covers Ampere, Ada, Hopper and
# Blackwell; listing only your own GPUs builds faster, e.g. 8.6;8.9 for an RTX 3090 and an RTX 4070
# (nvidia-smi --query-gpu=compute_cap --format=csv shows yours).
TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0;12.0

# Compiler jobs and threads per job for the SageAttention build. Each thread can take several GB of
# RAM, so raise these only with plenty to spare: running out can hang the machine.
MAX_JOBS=1
NVCC_THREADS=2
