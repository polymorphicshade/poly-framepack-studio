# Settings for the HTTPS stack (docker-compose.https.yml).
# Copy to .env in this directory - compose reads .env automatically:
#   cp .env.https.example .env

# Host port HTTPS is published on. The UI lives at https://<host>:<HTTPS_PORT>/
HTTPS_PORT=8443

# Host port for the app's plain HTTP listener. Bound to 127.0.0.1 in the HTTPS
# stack, so it is reachable only from the machine running Docker - HTTPS is the
# way in from anywhere else.
PORT=7860

# Subject of the generated self-signed certificate.
TLS_COMMON_NAME=localhost

# Every name and address you will use in the browser must be listed here, or the
# certificate will not match and the browser will warn on every visit. Add the
# LAN address of the Docker host alongside the loopback entries.
TLS_SAN=DNS:localhost,IP:127.0.0.1,IP:192.168.1.99

# The certificate is generated once, on first boot, into ./certs. After changing
# TLS_SAN or TLS_COMMON_NAME, delete it so a new one is minted:
#   docker compose -f docker-compose.https.yml down
#   rm -rf certs
#   docker compose -f docker-compose.https.yml up -d

# Host folder with your LoRAs (.safetensors / .pt), mounted at /data/loras. Create it before the
# first start so it is owned by you rather than root.
LORAS_DIR=./loras

# Extra studio.py flags.
FRAMEPACK_SERVE_ARGS=
# e.g. FRAMEPACK_SERVE_ARGS=--offline    (once the weights are downloaded)

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=

# Attention backend compiled into the image: sage (fastest, but compiled from source, which takes a
# while), flash (a prebuilt flash-attn wheel, no compiling) or none (PyTorch's own attention). Both
# sage and flash need an RTX 30-series or newer GPU; older GPUs fall back to PyTorch's attention.
ATTENTION=flash

# GPU architectures SageAttention is compiled for. The default covers Ampere, Ada, Hopper and
# Blackwell; listing only your own GPUs builds faster, e.g. 8.6;8.9 for an RTX 3090 and an RTX 4070
# (nvidia-smi --query-gpu=compute_cap --format=csv shows yours).
TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0;12.0

# Compiler jobs and threads per job for the SageAttention build. Each thread can take several GB of
# RAM, so raise these only with plenty to spare: running out can hang the machine.
MAX_JOBS=1
NVCC_THREADS=2
